#!/usr/bin/env bash
# Start a fresh container from the local-dev image. Each name is its own environment.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")" && pwd)"
cd "$ROOT"

usage() {
  cat <<'EOF'
Usage: ./devenv <command> [name]

  new [name] [workspace]   Start an environment. Name defaults to a timestamp.
                           If the name already exists, replace its container and keep the workspace.
  shell <name>             Open zsh in that environment
  ls                       List environments
  stop <name>              Stop an environment
  rm <name>                Remove the container. The workspace directory stays.
  build                    Rebuild the local-dev image

The container only sees its workspace directory. CURSOR_API_KEY is passed
through when it is set in the environment or in .env.

The container can use the public internet. Connections to this machine,
private networks, and link-local addresses are dropped.
EOF
}

require_name() {
  if [[ -z "${1:-}" ]]; then
    echo "environment name required" >&2
    exit 1
  fi
  if [[ ! "$1" =~ ^[a-z0-9]([a-z0-9-]{0,38}[a-z0-9])?$ ]]; then
    echo "name must be lowercase letters, numbers, and hyphens" >&2
    exit 1
  fi
}

short_name() {
  local name="$1"
  name="${name#devenv-}"
  printf '%s' "$name"
}

container_name() {
  printf 'devenv-%s' "$1"
}

refuse_workspace() {
  local ws="$1"
  local home blocked
  home="$(cd "$HOME" && pwd)"
  case "$ws" in
    /|/bin|/boot|/dev|/etc|/home|/lib|/lib64|/opt|/proc|/root|/run|/sbin|/sys|/usr|/var)
      echo "refusing to mount $ws into the container" >&2
      exit 1
      ;;
  esac
  if [[ "$ws" == "$home" || "$ws" == "$ROOT" ]]; then
    echo "refusing to mount $ws into the container" >&2
    exit 1
  fi
  for blocked in "$home/.ssh" "$home/.gnupg" "$home/.aws" "$home/.docker" "$home/.kube" "$home/.config/gh"; do
    if [[ "$ws" == "$blocked" || "$ws" == "$blocked"/* ]]; then
      echo "refusing to mount $ws into the container" >&2
      exit 1
    fi
  done
  case "$ws" in
    /run/*|/var/run/*|/dev/*|/proc/*|/sys/*|/etc/*)
      echo "refusing to mount $ws into the container" >&2
      exit 1
      ;;
  esac
}

lock_network() {
  local id="$1"
  local -a args=()
  local ip ns
  while read -r ns; do
    [[ -z "$ns" ]] && continue
    args+=(--dns "$ns")
  done < <(docker exec "$id" cat /etc/resolv.conf | awk '/^nameserver[[:space:]]/ {print $2}')
  while read -r ip; do
    [[ -z "$ip" ]] && continue
    args+=("$ip")
  done < <(ip -4 -o addr show scope global | awk '{print $4}' | cut -d/ -f1)
  docker run --rm \
    --network "container:${id}" \
    --user 0:0 \
    --cap-drop ALL \
    --cap-add NET_ADMIN \
    --cap-add NET_RAW \
    --entrypoint /usr/local/bin/lock-net \
    local-dev:latest \
    "${args[@]}"
}

container_id() {
  docker ps -aq --filter "label=dev.env=1" --filter "label=dev.env.name=$(container_name "$1")"
}

workspace_of() {
  local id
  id="$(container_id "$1")"
  if [[ -z "$id" ]]; then
    echo "no environment named $1" >&2
    exit 1
  fi
  docker inspect --format '{{index .Config.Labels "dev.env.workspace"}}' "$id"
}

export_host_ids() {
  export DEVENV_UID="$(id -u)"
  export DEVENV_GID="$(id -g)"
}

cmd_build() {
  export_host_ids
  docker compose build
}

cmd_new() {
  local name="${1:-$(date +%Y%m%d-%H%M%S)}"
  require_name "$name"
  local cname workspace
  cname="$(container_name "$name")"
  local replacing=0
  if [[ -n "$(container_id "$name")" ]]; then
    replacing=1
    if [[ -n "${2:-}" ]]; then
      workspace="$2"
    else
      workspace="$(workspace_of "$name")"
    fi
  else
    workspace="${2:-$ROOT/environments/$name}"
  fi
  if [[ "$workspace" != /* ]]; then
    workspace="$ROOT/$workspace"
  fi
  mkdir -p "$(dirname "$workspace")"
  workspace="$(cd "$(dirname "$workspace")" && pwd)/$(basename "$workspace")"
  refuse_workspace "$workspace"
  mkdir -p "$workspace"
  workspace="$(cd "$workspace" && pwd)"
  refuse_workspace "$workspace"
  export_host_ids
  export DEVENV_NAME="$cname"
  export DEVENV_WORKSPACE="$workspace"
  export COMPOSE_PROJECT_NAME="$cname"
  if [[ "$replacing" == 1 ]]; then
    docker compose down
  fi
  docker compose up -d --force-recreate
  local id
  id="$(container_id "$name")"
  if ! lock_network "$id"; then
    docker compose down
    echo "could not lock the container network; removed $name" >&2
    exit 1
  fi
  echo "environment $name"
  echo "workspace   $workspace"
  if [[ "$replacing" == 1 ]]; then
    echo "container   reset"
  fi
  echo "shell       ./devenv shell $name"
}

cmd_shell() {
  local name
  name="$(short_name "${1:-}")"
  require_name "$name"
  local id workspace
  id="$(container_id "$name")"
  if [[ -z "$id" ]]; then
    echo "no environment named $name" >&2
    exit 1
  fi
  workspace="$(workspace_of "$name")"
  docker start "$id" >/dev/null
  if ! lock_network "$id"; then
    docker stop "$id" >/dev/null
    echo "could not lock the container network; stopped $name" >&2
    exit 1
  fi
  exec docker exec -it -u "$(id -u):$(id -g)" -w "$workspace" "$id" zsh
}

cmd_ls() {
  local id name status workspace
  printf '%-16s %-12s %s\n' NAME STATUS WORKSPACE
  while read -r id; do
    [[ -z "$id" ]] && continue
    name="$(docker inspect --format '{{index .Config.Labels "dev.env.name"}}' "$id")"
    name="$(short_name "$name")"
    status="$(docker inspect --format '{{.State.Status}}' "$id")"
    workspace="$(docker inspect --format '{{index .Config.Labels "dev.env.workspace"}}' "$id")"
    printf '%-16s %-12s %s\n' "$name" "$status" "$workspace"
  done < <(docker ps -aq --filter label=dev.env=1)
}

cmd_stop() {
  local name
  name="$(short_name "${1:-}")"
  require_name "$name"
  local id
  id="$(container_id "$name")"
  if [[ -z "$id" ]]; then
    echo "no environment named $name" >&2
    exit 1
  fi
  docker stop "$id" >/dev/null
  echo "stopped $name"
}

cmd_rm() {
  local name
  name="$(short_name "${1:-}")"
  require_name "$name"
  local id workspace
  id="$(container_id "$name")"
  if [[ -z "$id" ]]; then
    echo "no environment named $name" >&2
    exit 1
  fi
  workspace="$(workspace_of "$name")"
  export_host_ids
  export DEVENV_NAME="$(container_name "$name")"
  export DEVENV_WORKSPACE="$workspace"
  export COMPOSE_PROJECT_NAME="$DEVENV_NAME"
  docker compose down
  echo "removed $name"
  echo "workspace kept at $workspace"
}

case "${1:-}" in
  new) shift; cmd_new "$@" ;;
  shell) shift; cmd_shell "$@" ;;
  ls) cmd_ls ;;
  stop) shift; cmd_stop "$@" ;;
  rm) shift; cmd_rm "$@" ;;
  build) cmd_build ;;
  -h|--help|help|"") usage ;;
  *) echo "unknown command: $1" >&2; usage; exit 1 ;;
esac
